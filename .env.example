# LLM fallback chain (tier 1 -> 3): Gemini Flash -> Groq Llama 3 -> DeepSeek
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama3-70b-8192
DEEPSEEK_MODEL=deepseek-chat

# Chunking
MAX_CHUNK_CHARS=12000
CHUNK_OVERLAP_CHARS=400

# Retries / backoff
MAX_RETRIES=5
BASE_BACKOFF_SECONDS=1.5
MAX_BACKOFF_SECONDS=60
JITTER_SECONDS=0.5

# Concurrency
SCRAPER_CONCURRENCY=20
LLM_CONCURRENCY=8
HTTP_TIMEOUT_SECONDS=30

# Freshness window (hours) for news/jobs
FRESHNESS_HOURS=24

# Storage
DATABASE_URL=sqlite+aiosqlite:///./data/pipeline.db
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials.json
GOOGLE_SHEET_ID=

# Anti-bot
PLAYWRIGHT_HEADLESS=true
PROXY_URL=

# Phase I minimums
MIN_STARTUPS=1000
MIN_PRODUCTS=1000
MIN_PAPERS=1000


